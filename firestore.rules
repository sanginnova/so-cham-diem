rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().isActive == true;
    }
    function admin() { return active() && profile().role in ['admin', 'owner']; }
    function teacher() { return active() && profile().role == 'teacher'; }
    function ownData(data) { return active() && data.teacherId == request.auth.uid && profile().role != 'monitor'; }
    function monitorData(data) { return active() && profile().role == 'monitor' && data.teacherId == profile().teacherId; }
    function monitorClass(data) {
      return monitorData(data) && (data.classId == profile().get('classConfigId', '')
        || (profile().get('classConfigId', '') == '' && get(/databases/$(database)/documents/classConfigs/$(data.classId)).data.get('scopeVersion', 1) != 2));
    }
    function readable(data) { return admin() || ownData(data) || monitorData(data); }
    function writable(data) { return admin() || ownData(data); }
    function stableOwner() { return request.resource.data.teacherId == resource.data.teacherId; }
    function validRosterSource(data) {
      let sourceId = data.get('rosterSourceClassId', '');
      return sourceId == '' || (data.get('classType', '') == 'subject'
        && sourceId != data.id
        && get(/databases/$(database)/documents/classConfigs/$(sourceId)).data.teacherId == data.teacherId
        && get(/databases/$(database)/documents/classConfigs/$(sourceId)).data.className == data.className
        && get(/databases/$(database)/documents/classConfigs/$(sourceId)).data.schoolYear == data.schoolYear
        && get(/databases/$(database)/documents/classConfigs/$(sourceId)).data.get('rosterSourceClassId', '') == '');
    }
    function managesMonitor(data) { return teacher() && data.role == 'monitor' && data.teacherId == request.auth.uid; }
    function validProfile(uid) {
      return request.resource.data.uid == uid && request.resource.data.role in ['teacher', 'monitor', 'admin', 'owner']
        && request.resource.data.isActive is bool && !request.resource.data.keys().hasAny(['password']);
    }
    function unlocked(type, value) {
      let id = type + '_' + string(value);
      return !exists(/databases/$(database)/documents/periodLocks/$(id))
        || get(/databases/$(database)/documents/periodLocks/$(id)).data.isLocked != true;
    }
    function classUnlocked(type, value, classId) {
      let id = classId + '__' + type + '_' + string(value);
      let config = get(/databases/$(database)/documents/classConfigs/$(classId)).data;
      return config.get('scopeVersion', 1) == 2
        ? (!exists(/databases/$(database)/documents/periodLocks/$(id)) || get(/databases/$(database)/documents/periodLocks/$(id)).data.isLocked != true)
        : unlocked(type, value);
    }
    function validLog() {
      let log = request.resource.data;
      return log.type in ['deduct', 'bonus'] && log.count is int && log.count > 0
        && log.month is int && log.month >= 1 && log.month <= 12
        && log.weekNumber is int && log.weekNumber >= 1 && log.weekNumber <= 53
        && log.scorePerUnit is number && log.scorePerUnit >= 0
        && log.totalScore is number && log.totalScore >= 0
        && log.totalScore >= log.scorePerUnit * log.count - 0.00501
        && log.totalScore <= log.scorePerUnit * log.count + 0.00501
        && get(/databases/$(database)/documents/students/$(log.studentId)).data.teacherId == log.teacherId
        && get(/databases/$(database)/documents/students/$(log.studentId)).data.classId == log.classId
        && get(/databases/$(database)/documents/classConfigs/$(log.classId)).data.teacherId == log.teacherId;
    }
    function semesterOpen(data) {
      let config = get(/databases/$(database)/documents/classConfigs/$(data.classId)).data;
      return config.semester1Months.hasAny([data.month]) ? classUnlocked('semester', 1, data.classId) : classUnlocked('semester', 2, data.classId);
    }
    function logOpen() { return classUnlocked('week', request.resource.data.weekNumber, request.resource.data.classId) && classUnlocked('month', request.resource.data.month, request.resource.data.classId) && semesterOpen(request.resource.data); }
    function monitorCanRecord(data) {
      return monitorClass(data) && ((data.type == 'deduct' && profile().permissions.canAddViolations == true)
        || (data.type == 'bonus' && profile().permissions.canAddBonuses == true));
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin() || managesMonitor(resource.data));
      allow list: if admin() || managesMonitor(resource.data);
      allow create: if signedIn() && validProfile(uid) && (admin()
        || (request.auth.uid == uid && request.resource.data.role == 'teacher'
          && request.resource.data.isActive == true && request.resource.data.teacherId == '')
        || (managesMonitor(request.resource.data)
          && get(/databases/$(database)/documents/classes/$(request.resource.data.assignedClassId)).data.teacherId == request.auth.uid));
      allow update: if active() && validProfile(uid) && (admin()
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'avatarUrl', 'lastLoginAt', 'updatedAt']))
        || (managesMonitor(resource.data) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'permissions', 'isActive', 'updatedAt', 'lastLoginAt', 'classConfigId'])
          && (request.resource.data.get('classConfigId', '') == '' || get(/databases/$(database)/documents/classConfigs/$(request.resource.data.classConfigId)).data.teacherId == request.auth.uid)));
      allow delete: if admin() || managesMonitor(resource.data);
    }
    match /classes/{id} {
      allow read: if readable(resource.data);
      allow create: if writable(request.resource.data);
      allow update: if writable(resource.data) && stableOwner();
      allow delete: if writable(resource.data);
    }
    match /{collection}/{id} {
      allow read: if collection in ['students', 'classConfigs', 'behaviorCategories', 'weeklySnapshots', 'monthlySummaries', 'semesterSummaries', 'parentReports']
        && (collection in ['classConfigs', 'behaviorCategories'] ? readable(resource.data)
          : (admin() || ownData(resource.data) || monitorClass(resource.data)));
      allow create: if collection in ['students', 'classConfigs', 'behaviorCategories', 'weeklySnapshots', 'monthlySummaries', 'semesterSummaries', 'parentReports'] && writable(request.resource.data)
        && (collection != 'classConfigs' || validRosterSource(request.resource.data))
        && (collection != 'students' || get(/databases/$(database)/documents/classConfigs/$(request.resource.data.classId)).data.get('rosterSourceClassId', '') == '');
      allow update: if collection in ['students', 'classConfigs', 'behaviorCategories', 'weeklySnapshots', 'monthlySummaries', 'semesterSummaries', 'parentReports'] && writable(resource.data) && stableOwner()
        && (collection != 'classConfigs' || (request.resource.data.get('rosterSourceClassId', '') == resource.data.get('rosterSourceClassId', '') && validRosterSource(request.resource.data)))
        && (collection != 'classConfigs' || resource.data.get('scopeVersion', 1) != 2
          || (request.resource.data.scopeVersion == 2 && request.resource.data.schoolYear == resource.data.schoolYear
            && request.resource.data.classDirectoryId == resource.data.classDirectoryId));
      allow delete: if collection in ['students', 'classConfigs', 'behaviorCategories', 'weeklySnapshots', 'monthlySummaries', 'semesterSummaries', 'parentReports'] && writable(resource.data);
    }
    match /subjectGradebooks/{id} {
      function config() { return get(/databases/$(database)/documents/classConfigs/$(id)).data; }
      function canUse() { return active() && profile().role in ['teacher', 'admin', 'owner'] && writable(config()); }
      function validGradebook() {
        let data = request.resource.data;
        return data.keys().hasOnly(['classId', 'teacherId', 'subjectName', 'schoolYear', 'teacherName', 'txCountSemester1', 'txCountSemester2', 'txLabelsSemester1', 'txLabelsSemester2', 'grades', 'updatedAt', 'revision', 'pendingSync'])
          && data.classId == id && data.teacherId == config().teacherId
          && data.schoolYear == config().schoolYear
          && data.subjectName == config().get('subjectName', config().get('teachingSubject', 'Toán'))
          && data.teacherName is string && data.updatedAt is string
          && data.grades is map && data.pendingSync == false
          && data.txCountSemester1 is int && data.txCountSemester1 >= 2 && data.txCountSemester1 <= 8
          && data.txCountSemester2 is int && data.txCountSemester2 >= 2 && data.txCountSemester2 <= 8
          && data.revision is int;
      }
      allow get: if canUse();
      allow list: if false;
      allow create: if canUse() && validGradebook() && request.resource.data.revision == 1;
      allow update: if canUse() && validGradebook() && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      allow delete: if false;
    }
    // Private GVCN records are never readable by monitors or parent portals.
    match /homeroomRecords/{id} {
      function validHomeroom() {
        let r = request.resource.data;
        return r.keys().hasOnly(['id', 'teacherId', 'classId', 'kind', 'studentId', 'date', 'data', 'createdAt', 'updatedAt', 'createdBy'])
          && r.id == id && r.kind in ['profile', 'contact', 'meeting', 'task', 'support', 'collection', 'payment', 'allowance']
          && r.studentId is string && r.date is string && r.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && r.data is map && r.data.size() <= 30 && r.createdAt is string && r.updatedAt is string
          && get(/databases/$(database)/documents/classConfigs/$(r.classId)).data.teacherId == r.teacherId
          && (r.studentId == '' ? r.kind in ['meeting', 'task', 'collection']
            : (get(/databases/$(database)/documents/students/$(r.studentId)).data.classId == r.classId
              && get(/databases/$(database)/documents/students/$(r.studentId)).data.teacherId == r.teacherId));
      }
      function validFinancial() {
        let r = request.resource.data;
        return !(r.kind in ['collection', 'payment', 'allowance'])
          || (r.kind == 'collection'
            ? (r.studentId == '' && r.data.name is string && r.data.name.size() > 0
              && r.data.amount is string && r.data.amount.matches('^(0|[1-9][0-9]{0,11})$')
              && r.data.studentIds is string && r.data.studentNames is string && r.data.status in ['Đang thu', 'Đã kết thúc'])
            : validLinkedCollection());
      }
      function validLinkedCollection() {
        let r = request.resource.data;
        let parent = getAfter(/databases/$(database)/documents/homeroomRecords/$(r.data.collectionId)).data;
        return parent.kind == 'collection' && parent.classId == r.classId && parent.teacherId == r.teacherId
          && r.studentId != '' && r.data.amount is string
          && (r.kind == 'payment'
            ? (r.data.amount.matches('^[1-9][0-9]{0,11}$') && r.data.method in ['Tiền mặt', 'Chuyển khoản', 'Khác']
              && (r.data.state == 'Đã ghi nhận' || (r.data.state == 'Đã hủy' && r.data.voidReason is string && r.data.voidReason.size() > 0)))
            : (r.data.amount.matches('^(0|[1-9][0-9]{0,11})$') && r.data.mode in ['Giảm', 'Miễn', 'Không áp dụng', 'Bình thường']
              && r.data.reason is string && (r.data.mode == 'Bình thường' || r.data.reason.size() > 0)));
      }
      function financialUpdate() {
        let r = request.resource.data;
        return r.kind == 'collection' ? (r.data.amount == resource.data.data.amount && r.data.studentIds == resource.data.data.studentIds && r.data.studentNames == resource.data.data.studentNames)
          : r.kind == 'payment' ? (r == resource.data || (r.date == resource.data.date
            && r.data.diff(resource.data.data).affectedKeys().hasOnly(['state', 'voidReason'])
            && resource.data.data.state == 'Đã ghi nhận' && r.data.state == 'Đã hủy'))
          : r.kind == 'allowance' ? r.data.collectionId == resource.data.data.collectionId : true;
      }
      allow read: if writable(resource.data);
      allow create: if writable(request.resource.data) && validFinancial() && validHomeroom() && request.resource.data.createdBy == request.auth.uid;
      allow update: if writable(resource.data) && stableOwner() && validHomeroom() && validFinancial() && financialUpdate()
        && request.resource.data.classId == resource.data.classId && request.resource.data.kind == resource.data.kind
        && request.resource.data.studentId == resource.data.studentId && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if writable(resource.data);
    }
    match /disciplineLogs/{id} {
      allow read: if admin() || ownData(resource.data) || (monitorClass(resource.data) && profile().permissions.canViewScores == true);
      allow create: if validLog() && logOpen() && request.resource.data.createdBy == request.auth.uid
        && (writable(request.resource.data) || monitorCanRecord(request.resource.data));
      allow update: if validLog() && logOpen() && classUnlocked('week', resource.data.weekNumber, resource.data.classId)
        && classUnlocked('month', resource.data.month, resource.data.classId) && semesterOpen(resource.data) && stableOwner()
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && (writable(resource.data) || (monitorCanRecord(request.resource.data) && resource.data.createdBy == request.auth.uid));
      allow delete: if writable(resource.data) && classUnlocked('week', resource.data.weekNumber, resource.data.classId) && classUnlocked('month', resource.data.month, resource.data.classId) && semesterOpen(resource.data);
    }
    match /periodLocks/{id} { allow read: if active(); allow write: if admin(); }
    function familyAccess(data) {
      return signedIn() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() == data.viewerEmail
        && data.revoked == false && request.time < data.expiresAt
        && get(/databases/$(database)/documents/users/$(data.teacherId)).data.isActive == true;
    }
    match /familyReports/{id} {
      allow get: if writable(resource.data) || familyAccess(resource.data);
      allow list: if writable(resource.data);
      allow create: if writable(request.resource.data)
        && request.resource.data.viewerEmail is string && request.resource.data.viewerEmail.size() > 3
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(31, 'd')
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherId == request.resource.data.teacherId
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.classId == request.resource.data.classId;
      allow update: if writable(resource.data) && stableOwner()
        && request.resource.data.studentId == resource.data.studentId && request.resource.data.classId == resource.data.classId
        && request.resource.data.viewerEmail == resource.data.viewerEmail
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt < request.time + duration.value(31, 'd');
      allow delete: if false;
    }
    match /correctionRequests/{id} {
      allow read: if writable(resource.data) || (signedIn() && resource.data.requesterId == request.auth.uid);
      allow create: if request.resource.data.keys().hasOnly(['reportId', 'teacherId', 'classId', 'studentId', 'logId', 'requesterId', 'requesterEmail', 'reason', 'requestedDescription', 'status', 'createdAt'])
        && familyAccess(get(/databases/$(database)/documents/familyReports/$(request.resource.data.reportId)).data)
        && request.resource.data.requesterId == request.auth.uid && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 1000
        && request.resource.data.requestedDescription is string && request.resource.data.requestedDescription.size() > 0 && request.resource.data.requestedDescription.size() <= 500
        && request.resource.data.teacherId == get(/databases/$(database)/documents/familyReports/$(request.resource.data.reportId)).data.teacherId
        && request.resource.data.classId == get(/databases/$(database)/documents/familyReports/$(request.resource.data.reportId)).data.classId
        && request.resource.data.studentId == get(/databases/$(database)/documents/familyReports/$(request.resource.data.reportId)).data.studentId
        && request.resource.data.logId in get(/databases/$(database)/documents/familyReports/$(request.resource.data.reportId)).data.logIds;
      allow update: if writable(resource.data) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected'] && request.resource.data.response is string && request.resource.data.response.size() > 0
        && request.resource.data.reviewedBy == request.auth.uid
        && (request.resource.data.status == 'rejected' || getAfter(/databases/$(database)/documents/disciplineLogs/$(resource.data.logId)).data.behaviorDescription == resource.data.requestedDescription);
      allow delete: if false;
    }
    match /disciplineTrash/{id} {
      allow read: if writable(resource.data);
      allow create: if writable(request.resource.data)
        && request.resource.data.log == get(/databases/$(database)/documents/disciplineLogs/$(id)).data
        && request.resource.data.teacherId == request.resource.data.log.teacherId && request.resource.data.classId == request.resource.data.log.classId;
      allow update: if false;
      allow delete: if writable(resource.data)
        && !exists(/databases/$(database)/documents/disciplineLogs/$(id))
        && getAfter(/databases/$(database)/documents/disciplineLogs/$(id)).data.teacherId == resource.data.teacherId
        && getAfter(/databases/$(database)/documents/disciplineLogs/$(id)).data.classId == resource.data.classId
        && getAfter(/databases/$(database)/documents/disciplineLogs/$(id)).data.studentId == resource.data.log.studentId;
    }
    match /auditLogs/{id} {
      allow read: if admin();
      allow create: if active() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
    match /publicScoreboards/{id} {
      allow read: if resource.data.isPublic == true || writable(resource.data) || (active() && resource.data.teacherId == request.auth.uid);
      allow create, update: if writable(request.resource.data) || (active() && request.resource.data.teacherId == request.auth.uid);
      allow delete: if writable(resource.data) || (active() && resource.data.teacherId == request.auth.uid);
    }
    // V2 hierarchy is restricted to administrators until its dedicated migration.
    match /{collection}/{id} {
      allow read, write: if collection in ['schools', 'academicYears', 'semesters', 'enrollments', 'systemConfigs'] && admin();
    }
  }
}
